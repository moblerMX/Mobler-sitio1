# Redirecciones del sitio anterior (Wix) al sitio nuevo
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
RewriteEngine On
# Dominio principal con www, como lo tenía indexado Google
RewriteCond %{HTTP_HOST} ^mobler\.mx$ [NC]
RewriteRule ^(.*)$ https://www.mobler.mx/$1 [R=301,L]
